{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@nabimo-auth/core": ["packages/core/src/index.ts"],
      "@nabimo-auth/core/*": ["packages/core/src/*"],
      "@nabimo-auth/database": ["packages/database/src/index.ts"],
      "@nabimo-auth/database/*": ["packages/database/src/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "packages/core/tsconfig.json" },
    { "path": "packages/database/tsconfig.json" },
    { "path": "apps/auth-server/tsconfig.json" }
  ]
}
