# PostgreSQL
DATABASE_URL=postgresql://nabimo:nabimo_dev@localhost:5432/nabimo_auth?schema=public

# JWT signing (EdDSA / Ed25519)
# Generate an Ed25519 private key for local development with Node.js, for example:
# node -e 'const {generateKeyPairSync}=require("node:crypto"); const {privateKey}=generateKeyPairSync("ed25519"); console.log(privateKey.export({type:"pkcs8",format:"pem"}))'
NABIMO_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
NABIMO_JWT_KEY_ID=nabimo-local
NABIMO_JWT_ISSUER=nabimo-auth
NABIMO_JWT_AUDIENCE=nabimo-api

# 32-byte key used to encrypt 2FA secrets.
# Generate one with: openssl rand -base64 32
NABIMO_2FA_ENCRYPTION_KEY=replace-with-a-32-byte-secret

# Comma-separated IP addresses of reverse proxies that you control.
# X-Forwarded-For is ignored unless the immediate peer is listed here.
# Example for a local Nginx reverse proxy:
# NABIMO_TRUSTED_PROXY_IPS=127.0.0.1,::1
NABIMO_TRUSTED_PROXY_IPS=
