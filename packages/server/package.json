{
  "name": "@nabimo-auth/server",
  "version": "0.1.0",
  "description": "HTTP server integration for Nabimo Auth.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./routes/auth": {
      "types": "./dist/routes/auth.d.ts",
      "import": "./dist/routes/auth.js"
    },
    "./contract": {
      "types": "./dist/api-contract.d.ts",
      "import": "./dist/api-contract.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nabimo-auth/core": "workspace:*",
    "@nabimo-auth/protocol": "workspace:*",
    "h3": "^1.15.11"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
