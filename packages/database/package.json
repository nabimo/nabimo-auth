{
  "name": "@nabimo-auth/database",
  "version": "0.1.0",
  "private": false,
  "description": "Prisma database layer for Nabimo Auth.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "generate": "prisma generate --config ../../prisma.config.ts",
    "prebuild": "pnpm generate",
    "build": "tsc",
    "prelint": "pnpm generate",
    "lint": "eslint .",
    "pretest": "pnpm generate",
    "test": "vitest run --passWithNoTests",
    "pretypecheck": "pnpm generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nabimo-auth/core": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.10.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
